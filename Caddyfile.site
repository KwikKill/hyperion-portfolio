gabriel.{$WEBSITE_HOST} {
	import cors

	root * /srv/infra/volumes/hyperion
	# Prerendered routes live in <route>/index.html. Anything else falls back to
	# Nuxt's SPA shell (200.html), which renders the route client-side; falling
	# back to /index.html would serve the prerendered home page instead.
	try_files {path} {path}/index.html /200.html

	# Compress text responses (HTML, CSS, JavaScript, JSON, SVG): about 4 times lighter.
	# Images are already compressed and left as they are.
	encode zstd gzip

	# Nuxt's build files carry a hash in their name: a new build means new names.
	handle /_nuxt/* {
		header Cache-Control "public, immutable, max-age=31536000"
		file_server
	}

	# Pages and the rest: checked again on every visit (a cheap 304 thanks to the ETag).
	# Without it, browsers keep an old page for days after a deploy, with the old
	# JavaScript it points to already gone.
	handle {
		header Cache-Control "no-cache"
		file_server
	}
}
